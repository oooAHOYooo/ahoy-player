{
  "name": "ahoy-player",
  "private": true,
  "version": "0.1.1",
  "description": "Local-first Ahoy Player with a native Rust GUI and native CLI/TUI.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:native": "cargo run -p ahoy-player",
    "build:native": "cargo build --release -p ahoy-player",
    "test:native": "cargo test --workspace",
    "dev:web": "npm run dev --workspace @ahoy/player-web",
    "ahoy": "npm run start --workspace @ahoy/player-terminal --",
    "dev:terminal": "npm run start --workspace @ahoy/player-terminal -- tui",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "allowScripts": { "esbuild@0.21.5": true }
}
