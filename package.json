{
  "name": "ahoy-player",
  "private": true,
  "version": "0.1.1",
  "description": "Local-first Ahoy Player monorepo with desktop, touch, TV, and future console shells.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace @ahoy/player-desktop",
    "dev:web": "npm run dev --workspace @ahoy/player-web",
    "dev:kiosk": "npm run dev --workspace @ahoy/player-linux-kiosk",
    "ahoy": "npm run start --workspace @ahoy/player-terminal --",
    "dev:terminal": "npm run start --workspace @ahoy/player-terminal -- tui",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
