import { Button, CheckBox, HorizontalBox, VerticalBox, Slider, ListView, LineEdit } from "std-widgets.slint";

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    callback clicked();
    height: 36px;
    min-width: 42px;
    background: accent ? (hit.has-hover ? #9af0c1 : #83dfb0) : (hit.has-hover ? #293c3b : #1b2929);
    border-color: button-focus.has-focus ? #ffffff : (accent ? #83dfb0 : #344746);
    border-width: button-focus.has-focus ? 2px : 1px;
    border-radius: 8px;
    Text {
        text: root.label;
        color: root.accent ? #092018 : #dce9e4;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    button-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
        hit := TouchArea { clicked => { button-focus.focus(); root.clicked(); } }
    }
}

export component AppWindow inherits Window {
    title: "Ahoy Player";
    no-frame: false;
    min-width: 900px;
    min-height: 640px;
    preferred-width: 1360px;
    preferred-height: 860px;

    in-out property <[string]> track-items: [];
    in-out property <[string]> track-ids: [];
    in-out property <[string]> queue-items: [];
    in-out property <[string]> queue-ids: [];
    in-out property <[string]> playlists: [];
    in-out property <string> eq-name: "Flat";
    in-out property <string> current-track-id: "";
    in-out property <string> search-query: "";
    in-out property <int> library-view: 0;
    in-out property <int> keyboard-selected-index: 0;
    in-out property <string> alert: "";
    in-out property <string> now-title: "Nothing queued";
    in-out property <string> now-artist: "";
    in-out property <string> now-album: "";
    in-out property <image> now-artwork;
    in-out property <bool> has-artwork: false;
    in-out property <string> now-playing: "Nothing queued";
    in-out property <string> status: "Ready";
    in-out property <string> update-status: "Checking updates…";
    in-out property <string> theme-name: "Neutral";
    in-out property <string> ahoy-id: "";
    in-out property <bool> playing: false;
    in-out property <bool> show-library: true;
    in-out property <bool> show-queue: true;
    in-out property <bool> show-welcome-modal: false;
    in-out property <bool> remix-enabled: false;
    in-out property <bool> synth: false;
    in-out property <bool> echo: false;
    in-out property <bool> chorus: false;
    in-out property <bool> lo-fi: false;
    in-out property <bool> shuffle: false;
    in-out property <bool> repeat: false;
    in-out property <float> playback-position: 0;
    in-out property <float> playback-duration: 0;
    in-out property <string> playback-time: "0:00 / 0:00";
    in-out property <float> volume: 100;
    in-out property <float> song-volume: 100;
    in-out property <float> remix-volume: 80;
    in-out property <color> background-color: #0b1112;
    in-out property <color> surface-color: #121c1d;
    in-out property <color> text-color: #e5eeee;
    in-out property <color> accent-color: #83dfb0;
    in-out property <color> border-color: #263536;

    callback login-ahoy();
    callback logout-ahoy();
    callback dismiss-welcome();
    callback import-files();
    callback reload-library();
    callback select-track(int);
    callback select-queue-track(int);
    callback clear-queue();
    callback remove-queue-track(int);
    callback move-queue-track(int, int);
    callback save-queue-as-playlist();
    callback select-playlist(int);
    callback cycle-eq();
    callback search-changed(string);
    callback select-library-view(int);
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback next-theme();
    callback save-theme();
    callback import-theme();
    callback export-theme();
    callback toggle-library();
    callback toggle-queue();
    callback set-volume(float);
    callback set-song-volume(float);
    callback set-remix-volume(float);
    callback toggle-remix();
    callback play-remix-note(int, bool);
    callback toggle-synth();
    callback toggle-echo();
    callback toggle-chorus();
    callback toggle-lofi();
    callback toggle-shuffle();
    callback toggle-repeat();
    callback close-window();
    callback minimize-window();
    callback update-action();
    callback request-playback(bool);
    callback seek-to(float);

    background: root.background-color;

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.DownArrow && root.track-items.length > 0) { root.keyboard-selected-index = min(root.keyboard-selected-index + 1, root.track-items.length - 1); return accept; }
            if (event.text == Key.UpArrow && root.track-items.length > 0) { root.keyboard-selected-index = max(root.keyboard-selected-index - 1, 0); return accept; }
            if (event.text == Key.Return && root.track-items.length > 0) { root.select-track(root.keyboard-selected-index); return accept; }
            if (event.text == " ") { root.toggle-play(); return accept; }
            if (event.text == Key.RightArrow) { root.next-track(); return accept; }
            if (event.text == Key.LeftArrow) { root.previous-track(); return accept; }
            if (event.text == "m" || event.text == "M") { root.toggle-remix(); return accept; }
            if (root.remix-enabled && (event.text == "q" || event.text == "Q")) { root.play-remix-note(0, event.text == "Q"); return accept; }
            if (root.remix-enabled && (event.text == "w" || event.text == "W")) { root.play-remix-note(1, event.text == "W"); return accept; }
            if (root.remix-enabled && (event.text == "e" || event.text == "E")) { root.play-remix-note(2, event.text == "E"); return accept; }
            if (root.remix-enabled && (event.text == "r" || event.text == "R")) { root.play-remix-note(3, event.text == "R"); return accept; }
            if (root.remix-enabled && (event.text == "t" || event.text == "T")) { root.play-remix-note(4, event.text == "T"); return accept; }
            if (root.remix-enabled && (event.text == "y" || event.text == "Y")) { root.play-remix-note(5, event.text == "Y"); return accept; }
            if (root.remix-enabled && (event.text == "u" || event.text == "U")) { root.play-remix-note(6, event.text == "U"); return accept; }
            if (root.remix-enabled && (event.text == "i" || event.text == "I")) { root.play-remix-note(7, event.text == "I"); return accept; }
            if (!root.remix-enabled && event.text == "s") { root.toggle-shuffle(); return accept; }
            if (!root.remix-enabled && event.text == "r") { root.toggle-repeat(); return accept; }
            if (event.text == Key.Escape) {
                if (root.search-query != "") { root.search-query = ""; root.search-changed(""); return accept; }
                if (root.show-welcome-modal) { root.dismiss-welcome(); return accept; }
            }
            return reject;
        }

        VerticalBox {
            spacing: 0px;
            padding: 0px;

            HorizontalBox {
                height: 62px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 10px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.accent-color;
                    border-radius: 16px;
                    Text { text: "a"; color: #092018; font-size: 20px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "Ahoy"; color: root.text-color; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                Text { text: "LOCAL MUSIC"; color: #738683; font-size: 9px; vertical-alignment: center; }
                Text { text: ""; horizontal-stretch: 1; }
                Text { text: root.status; color: #91aaa5; font-size: 10px; vertical-alignment: center; }
                ActionButton { width: 118px; label: root.update-status; clicked => { root.update-action(); } }
                ActionButton { label: root.show-library ? "Hide library" : "Show library"; clicked => { root.toggle-library(); } }
                ActionButton { label: root.show-queue ? "Hide queue" : "Show queue"; clicked => { root.toggle-queue(); } }
            }

            Rectangle { height: 1px; background: root.border-color; }

            HorizontalBox {
                spacing: 0px;
                vertical-stretch: 1;

                if root.show-library: Rectangle {
                    width: 210px;
                    background: #0e1718;
                    VerticalBox {
                        padding: 18px;
                        spacing: 8px;
                        Text { text: "YOUR MUSIC"; color: #718681; font-size: 9px; font-weight: 700; }
                        Rectangle {
                            height: 38px;
                            background: #203332;
                            border-radius: 8px;
                            HorizontalBox { padding-left: 11px; Text { text: "♫   All music"; color: root.text-color; font-size: 12px; vertical-alignment: center; } }
                        }
                        Text { text: "Browse and search your local files in the library."; color: #a1b2ae; font-size: 10px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: root.border-color; }
                        Text { text: "PLAYLISTS"; color: #718681; font-size: 9px; font-weight: 700; }
                        for playlist[index] in root.playlists: Rectangle {
                            height: 28px;
                            background: pl-touch.has-hover ? #203332 : #00000000;
                            border-radius: 4px;
                            pl-touch := TouchArea {
                                HorizontalBox {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text { text: "≡  " + playlist; color: #b0c2be; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                }
                                clicked => { root.select-playlist(index); }
                            }
                        }
                        if root.playlists.length == 0: Text { text: "No playlists yet."; color: #718681; font-size: 10px; }
                        ActionButton { label: "＋ Save queue as playlist"; clicked => { root.save-queue-as-playlist(); } }
                        Text { text: ""; vertical-stretch: 1; }
                        Rectangle { height: 1px; background: root.border-color; }
                        Text { text: "ACCOUNT"; color: #718681; font-size: 9px; font-weight: 700; }
                        if root.ahoy-id != "": Text { text: "⚓  " + root.ahoy-id; color: root.accent-color; font-size: 10px; overflow: elide; }
                        if root.ahoy-id != "": ActionButton { label: "Sign out"; clicked => { root.logout-ahoy(); } }
                        if root.ahoy-id == "": ActionButton { label: "Connect Ahoy ID"; clicked => { root.login-ahoy(); } }
                        Text { text: "Local playback works without an account."; color: #718681; font-size: 9px; wrap: word-wrap; }
                    }
                }

                VerticalBox {
                    padding: 24px;
                    spacing: 16px;
                    horizontal-stretch: 1;

                    HorizontalBox {
                        height: 58px;
                        VerticalBox {
                            spacing: 3px;
                            Text { text: "Your library"; color: root.text-color; font-size: 25px; font-weight: 700; }
                            Text { text: "A private home for the music you already own."; color: #8a9c98; font-size: 11px; }
                        }
                        Text { text: ""; horizontal-stretch: 1; }
                        ActionButton { label: "Reload"; clicked => { root.reload-library(); } }
                        ActionButton { label: "＋  Add music"; accent: true; clicked => { root.import-files(); } }
                    }

                    HorizontalBox {
                        height: 38px;
                        spacing: 8px;
                        ActionButton { label: "Tracks"; accent: root.library-view == 0; clicked => { root.select-library-view(0); } }
                        ActionButton { label: "Artists"; accent: root.library-view == 1; clicked => { root.select-library-view(1); } }
                        ActionButton { label: "Albums"; accent: root.library-view == 2; clicked => { root.select-library-view(2); } }
                        Text { text: ""; horizontal-stretch: 1; }
                        LineEdit { width: 230px; placeholder-text: "Search tracks, artists, albums"; text: root.search-query; edited(value) => { root.search-changed(value); } }
                        if root.search-query != "": ActionButton { label: "✕"; clicked => { root.search-query = ""; root.search-changed(""); } }
                    }

                    if root.alert != "": Rectangle {
                        height: 48px;
                        background: #3b281d;
                        border-color: #a66a43;
                        border-width: 1px;
                        border-radius: 8px;
                        HorizontalBox {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text { text: root.alert; color: #ffe4cc; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                            ActionButton { label: "Reload"; clicked => { root.reload-library(); } }
                        }
                    }

                    if root.queue-items.length == 0: Rectangle {
                        vertical-stretch: 1;
                        background: root.surface-color;
                        border-color: root.border-color;
                        border-width: 1px;
                        border-radius: 14px;
                        VerticalBox {
                            alignment: center;
                            padding: 32px;
                            spacing: 12px;
                            Rectangle {
                                width: 84px;
                                height: 84px;
                                background: #173c35;
                                border-radius: 42px;
                                Text { text: "♫"; color: root.accent-color; font-size: 40px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Start with your music"; color: root.text-color; font-size: 21px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: "Choose a folder or a few MP3s. Ahoy keeps your collection on this device."; color: #91a29e; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                            ActionButton { label: "Choose music files"; accent: true; clicked => { root.import-files(); } }
                            Text { text: "No account needed · Your files stay where they are"; color: #718681; font-size: 9px; horizontal-alignment: center; }
                        }
                    }

                    if root.queue-items.length > 0: Rectangle {
                        vertical-stretch: 1;
                        background: root.surface-color;
                        border-color: root.border-color;
                        border-width: 1px;
                        border-radius: 14px;
                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;
                            HorizontalBox {
                                height: 32px;
                                Text { text: root.library-view == 1 ? "By artist" : (root.library-view == 2 ? "By album" : "All tracks"); color: root.text-color; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                Text { text: ""; horizontal-stretch: 1; }
                                Text { text: root.track-items.length + " tracks"; color: #8a9c98; font-size: 10px; vertical-alignment: center; }
                            }
                            Rectangle {
                                height: 30px;
                                background: #1a2828;
                                border-radius: 6px;
                                HorizontalBox {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text { text: "#"; width: 42px; color: #718681; font-size: 9px; vertical-alignment: center; }
                                    Text { text: "TRACK  ·  ARTIST  ·  ALBUM"; color: #718681; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                }
                            }
                            ListView {
                                for track[index] in root.track-items: Rectangle {
                                    height: 42px;
                                    background: root.track-ids[index] == root.current-track-id ? #204638 : (index == root.keyboard-selected-index ? #203633 : (row.has-hover ? #203332 : #00000000));
                                    border-radius: 6px;
                                    row := TouchArea {
                                        HorizontalBox {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text { text: root.track-ids[index] == root.current-track-id ? (root.playing ? "▶" : "Ⅱ") : (index + 1) + ""; width: 42px; color: root.accent-color; font-size: 10px; vertical-alignment: center; }
                                            Text { text: track; color: root.track-ids[index] == root.current-track-id ? #ffffff : root.text-color; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        }
                                        clicked => { root.keyboard-selected-index = index; root.select-track(index); }
                                    }
                                }
                            }
                            if root.track-items.length == 0: VerticalBox {
                                alignment: center;
                                padding: 20px;
                                spacing: 8px;
                                Text { text: root.search-query != "" ? "No matches for \"" + root.search-query + "\"" : "No tracks found."; color: #9aaba6; font-size: 12px; horizontal-alignment: center; }
                                if root.search-query != "": ActionButton { label: "Clear search"; clicked => { root.search-query = ""; root.search-changed(""); } }
                            }
                        }
                    }

                    Rectangle {
                        height: 112px;
                        background: #10191a;
                        border-color: root.border-color;
                        border-width: 1px;
                        border-radius: 12px;
                        HorizontalBox {
                            padding: 12px;
                            spacing: 14px;
                            VerticalBox {
                                spacing: 4px;
                                HorizontalBox {
                                    Text { text: "REMIX"; color: root.accent-color; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "  Play notes over your music"; color: #8a9c98; font-size: 10px; vertical-alignment: center; }
                                    Text { text: ""; horizontal-stretch: 1; }
                                    ActionButton { label: root.remix-enabled ? "Keys on · M" : "Enable keys · M"; clicked => { root.toggle-remix(); } }
                                }
                                HorizontalBox {
                                    spacing: 5px;
                                    for key[index] in ["Q", "W", "E", "R", "T", "Y", "U", "I"]: ActionButton {
                                        label: key;
                                        width: 36px;
                                        height: 30px;
                                        clicked => { root.play-remix-note(index, false); }
                                    }
                                    Text { text: "Shift + key for synth"; color: #718681; font-size: 9px; vertical-alignment: center; }
                                    Text { text: ""; horizontal-stretch: 1; }
                                    ActionButton { label: root.synth ? "Synth · on" : "Synth"; clicked => { root.toggle-synth(); } }
                                    ActionButton { label: root.echo ? "Echo · on" : "Echo"; clicked => { root.toggle-echo(); } }
                                    ActionButton { label: root.chorus ? "Chorus · on" : "Chorus"; clicked => { root.toggle-chorus(); } }
                                    ActionButton { label: root.lo-fi ? "Lo-fi · on" : "Lo-fi"; clicked => { root.toggle-lofi(); } }
                                }
                            }
                        }
                    }
                }

                if root.show-queue: Rectangle {
                    width: 246px;
                    background: #0e1718;
                    VerticalBox {
                        padding: 16px;
                        spacing: 10px;
                        HorizontalBox {
                            height: 30px;
                            Text { text: "Up next"; color: root.text-color; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                            Text { text: ""; horizontal-stretch: 1; }
                            if root.queue-items.length > 0: ActionButton { label: "Clear"; clicked => { root.clear-queue(); } }
                            Text { text: root.queue-items.length + ""; color: #8a9c98; font-size: 10px; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: root.border-color; }
                        ListView {
                            for track[index] in root.queue-items: Rectangle {
                                height: 42px;
                                background: root.queue-ids[index] == root.current-track-id ? #204638 : (queue-row.has-hover ? #203332 : #00000000);
                                border-radius: 6px;
                                queue-row := TouchArea {
                                    HorizontalBox {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        Text { text: root.queue-ids[index] == root.current-track-id ? (root.playing ? "▶" : "Ⅱ") : (index + 1) + ""; width: 22px; color: root.accent-color; font-size: 9px; vertical-alignment: center; }
                                        Text { text: track; color: #c2cfca; font-size: 10px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        if index > 0: ActionButton { width: 24px; label: "▲"; clicked => { root.move-queue-track(index, index - 1); } }
                                        if index < root.queue-items.length - 1: ActionButton { width: 24px; label: "▼"; clicked => { root.move-queue-track(index, index + 1); } }
                                        ActionButton { width: 24px; label: "✕"; clicked => { root.remove-queue-track(index); } }
                                    }
                                    clicked => { root.select-queue-track(index); }
                                }
                            }
                        }
                        if root.queue-items.length == 0: VerticalBox {
                            alignment: center;
                            Text { text: "Nothing queued yet"; color: #a1b2ae; font-size: 11px; horizontal-alignment: center; }
                            Text { text: "Add music to build your queue."; color: #718681; font-size: 9px; horizontal-alignment: center; }
                        }
                        Text { text: ""; vertical-stretch: 1; }
                        Rectangle { height: 1px; background: root.border-color; }
                        Text { text: (root.shuffle ? "Shuffle on" : "Shuffle off") + "     ·     " + (root.repeat ? "Repeat on" : "Repeat off"); color: #91aaa5; font-size: 9px; }
                    }
                }
            }

            Rectangle { height: 1px; background: root.border-color; }

            Rectangle {
                height: 114px;
                background: #101819;
                HorizontalBox {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    Rectangle {
                        width: 68px;
                        height: 68px;
                        background: #183b33;
                        border-radius: 8px;
                        if root.has-artwork: Image { source: root.now-artwork; image-fit: contain; }
                        if !root.has-artwork: Text { text: "♫"; color: root.accent-color; font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "NOW PLAYING"; color: root.accent-color; font-size: 8px; font-weight: 700; }
                        Text { text: root.now-title; color: root.text-color; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: root.now-artist + (root.now-album == "" ? "" : " · " + root.now-album); color: #b1c2bc; font-size: 10px; overflow: elide; }
                        Text { text: root.playback-duration > 0 ? root.playback-time : (root.playing ? "Playing from your library" : "Choose a track to start listening"); color: #82928f; font-size: 9px; }
                        Slider { minimum: 0; maximum: root.playback-duration > 0 ? root.playback-duration : 1; value: root.playback-position; enabled: root.playback-duration > 0; changed(value) => { root.seek-to(value); } }
                    }
                    Text { text: ""; horizontal-stretch: 1; }
                    ActionButton { label: root.shuffle ? "Shuffle on" : "Shuffle"; clicked => { root.toggle-shuffle(); } }
                    ActionButton { label: "|◀"; clicked => { root.previous-track(); } }
                    ActionButton { label: root.playing ? "Ⅱ" : "▶"; accent: true; clicked => { root.toggle-play(); } }
                    ActionButton { label: "▶|"; clicked => { root.next-track(); } }
                    ActionButton { label: root.repeat ? "Repeat on" : "Repeat"; clicked => { root.toggle-repeat(); } }
                    VerticalBox {
                        width: 150px;
                        spacing: 2px;
                        HorizontalBox {
                            padding: 0px;
                            spacing: 0px;
                            Text { text: root.volume == 0 ? "MUTED" : "VOLUME"; color: root.volume == 0 ? #e07070 : #718681; font-size: 8px; font-weight: 700; vertical-alignment: center; }
                            Text { text: ""; horizontal-stretch: 1; }
                            Text { text: round(root.volume) + "%"; color: #82928f; font-size: 8px; vertical-alignment: center; }
                        }
                        Slider { minimum: 0; maximum: 100; value: root.volume; changed(value) => { root.set-volume(value); } }
                    }
                    ActionButton { label: "EQ: " + root.eq-name; clicked => { root.cycle-eq(); } }
                    Text { text: root.theme-name; color: root.accent-color; font-size: 9px; vertical-alignment: center; }
                }
            }

            if root.show-welcome-modal: Rectangle {
                background: #000000bb;
                width: 100%;
                height: 100%;
                TouchArea { }
                Rectangle {
                    width: 408px;
                    height: 286px;
                    background: root.surface-color;
                    border-radius: 14px;
                    border-color: root.border-color;
                    border-width: 1px;
                    VerticalBox {
                        padding: 30px;
                        spacing: 15px;
                        alignment: center;
                        Text { text: "Welcome aboard"; color: root.accent-color; font-size: 23px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Connect your Ahoy ID. Account library sync is not available yet; local music works without signing in."; color: root.text-color; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                        Text { text: ""; vertical-stretch: 1; }
                        ActionButton { label: "Connect Ahoy ID"; accent: true; clicked => { root.login-ahoy(); root.dismiss-welcome(); } }
                        ActionButton { label: "Continue with local music"; clicked => { root.dismiss-welcome(); } }
                    }
                }
            }
        }
    }
}
