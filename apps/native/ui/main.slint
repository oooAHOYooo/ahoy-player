import { Button, CheckBox, HorizontalBox, VerticalBox, Slider, ScrollView, ListView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Ahoy Player";
    no-frame: true;
    min-width: 860px; min-height: 600px; preferred-width: 1220px; preferred-height: 760px;
    in-out property <[string]> track-items: [];
    in-out property <string> now-playing: "Nothing queued";
    in-out property <string> status: "Ready";
    in-out property <string> theme-name: "Neutral";
    in-out property <string> ahoy-id: "";
    callback login-ahoy(); callback logout-ahoy();
    in-out property <bool> show-welcome-modal: false;
    callback dismiss-welcome();


    in-out property <bool> playing: false;
    in-out property <bool> show-library: true;
    in-out property <bool> show-queue: true;
    in-out property <float> volume: 100;
    in-out property <color> background-color: #f4f6f7;
    in-out property <color> surface-color: #ffffff;
    in-out property <color> text-color: #172126;
    in-out property <color> accent-color: #197b78;
    in-out property <color> border-color: #d9e1e3;
    callback import-files(); callback select-track(int); callback toggle-play(); callback next-track(); callback previous-track(); callback next-theme(); callback save-theme(); callback import-theme(); callback export-theme(); callback toggle-library(); callback toggle-queue();
    callback import-dropped-files([string]); callback set-volume(float); callback close-window(); callback minimize-window();
    
    background: root.background-color;

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == " ") { root.toggle-play(); return accept; }
            if (event.text == Key.RightArrow) { root.next-track(); return accept; }
            if (event.text == Key.LeftArrow) { root.previous-track(); return accept; }
            return reject;
        }
        VerticalBox {
            spacing: 0px; padding: 0px;
            // Custom Title Bar
            Rectangle {
                height: 32px; background: root.background-color;
                HorizontalBox {
                    padding-left: 12px; padding-right: 12px; padding-top: 0px; padding-bottom: 0px;
                    Text { text: "AHOY PLAYER"; color: #789092; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                    Text { text: ""; horizontal-stretch: 1; }
                    // We don't have direct close callbacks yet, but placeholders
                    Button { text: "—"; width: 30px; clicked => { root.minimize-window(); } }
                    Button { text: "X"; width: 30px; clicked => { root.close-window(); } }
                }
            }
            HorizontalBox {
                spacing: 0px;
        // Column 1: Library & Workspace Navigation
        Rectangle {
            visible: root.show-library;
            width: 218px; background: #172326;
            VerticalBox {
                padding: 18px; spacing: 20px;
                HorizontalBox { spacing: 10px; height: 40px;
                    Rectangle { width: 34px; height: 34px; background: root.accent-color; border-radius: 17px; Text { text: "A"; color: #ffffff; font-size: 21px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                    VerticalBox { spacing: 0px; Text { text: "AHOY"; color: #ffffff; font-size: 18px; font-weight: 700; } Text { text: "LOCAL PLAYER"; color: #9aabad; font-size: 9px; } }
                }
                Text { text: "YOUR LIBRARY"; color: #789092; font-size: 10px; font-weight: 700; }
                VerticalBox { spacing: 5px;
                    Rectangle { height: 36px; background: ta-lib.has-hover ? #3c5152 : #2c4142; border-radius: 6px; ta-lib := TouchArea { HorizontalBox { padding: 10px; Text { text: "▦  Library"; color: #ffffff; vertical-alignment: center; } } } }
                    Rectangle { height: 36px; background: ta-art.has-hover ? #233538 : #00000000; border-radius: 6px; ta-art := TouchArea { HorizontalBox { padding: 10px; Text { text: "◌  Artists"; color: #b7c5c6; vertical-alignment: center; } } } }
                    Rectangle { height: 36px; background: ta-alb.has-hover ? #233538 : #00000000; border-radius: 6px; ta-alb := TouchArea { HorizontalBox { padding: 10px; Text { text: "□  Albums"; color: #b7c5c6; vertical-alignment: center; } } } }
                    Rectangle { height: 36px; background: ta-rec.has-hover ? #233538 : #00000000; border-radius: 6px; ta-rec := TouchArea { HorizontalBox { padding: 10px; Text { text: "↗  Recently added"; color: #b7c5c6; vertical-alignment: center; } } } }
                }
                Text { text: "PLAYLISTS"; color: #789092; font-size: 10px; font-weight: 700; }
                VerticalBox { spacing: 4px; Text { text: "◈  All music"; color: #b7c5c6; } Text { text: "◌  Open archive moods"; color: #b7c5c6; } Text { text: "+  New playlist"; color: #b7c5c6; } }
                Rectangle { height: 1px; background: #385052; }
                VerticalBox { spacing: 4px; Text { text: "AHOY ID"; color: #789092; font-size: 10px; font-weight: 700; }
                    if root.ahoy-id != "": Text { text: "⚓ " + root.ahoy-id; color: #8ed0b0; font-size: 12px; }
                    if root.ahoy-id != "": TouchArea { width: 100%; height: 20px; clicked => { root.logout-ahoy(); } Text { text: "Sign out"; color: #789092; font-size: 10px; } }
                    if root.ahoy-id == "": TouchArea { width: 100%; height: 20px; clicked => { root.login-ahoy(); } Text { text: "Sign in (Web)"; color: #8ed0b0; font-size: 12px; } }
                }
                Text { text: ""; vertical-stretch: 1; }
                Text { text: "AHOY PLAYER  ·  0.2"; color: #617577; font-size: 10px; }
            }
        }

        // Column 2: Center Music & Overview
        VerticalBox {
            padding: 18px; spacing: 18px; horizontal-stretch: 1;
            Rectangle { height: 58px; background: root.surface-color; border-color: root.border-color; border-width: 1px; HorizontalBox { spacing: 12px; Text { text: "LIBRARY  /  OVERVIEW"; color: root.accent-color; font-size: 11px; font-weight: 700; vertical-alignment: center; } Text { text: ""; horizontal-stretch: 1; } Text { text: root.status; color: root.accent-color; vertical-alignment: center; } } }
            HorizontalBox { spacing: 14px; VerticalBox { spacing: 4px; Text { text: "YOUR MUSIC"; color: root.accent-color; font-size: 11px; font-weight: 700; } Text { text: "A quieter way to listen."; color: root.text-color; font-size: 28px; font-weight: 700; } Text { text: "Local files, clean metadata, and no account required."; color: #6e7c81; font-size: 13px; } } Text { text: ""; horizontal-stretch: 1; } Button { text: "🔍  Scan for MP3s"; clicked => { root.import-files(); } } }
            Rectangle { height: 164px; background: root.surface-color; border-color: root.border-color; border-width: 1px; border-radius: 12px;
                HorizontalBox { padding: 18px; spacing: 18px;
                    Rectangle { width: 128px; background: root.accent-color; border-radius: 8px; VerticalBox { padding: 12px; Text { text: "AHOY"; color: #ffffff; font-size: 11px; font-weight: 700; } Text { text: "◒"; color: #ffffff; font-size: 52px; horizontal-alignment: center; vertical-alignment: center; } Text { text: "LOCAL SOUND"; color: #d8f1ed; font-size: 9px; horizontal-alignment: center; } } }
                    VerticalBox { spacing: 5px; Text { text: "NOW PLAYING"; color: root.accent-color; font-size: 10px; font-weight: 700; } Text { text: root.now-playing; color: root.text-color; font-size: 21px; font-weight: 700; } Text { text: root.playing ? "Playing from your local library" : "Choose a track from your library"; color: #718085; font-size: 12px; } Text { text: ""; vertical-stretch: 1; } HorizontalBox { spacing: 7px; Button { text: "|◀"; clicked => { root.previous-track(); } } Button { text: root.playing ? "Ⅱ" : "▶"; clicked => { root.toggle-play(); } } Button { text: "▶|"; clicked => { root.next-track(); } } Text { text: "VOL"; color: #718085; vertical-alignment: center; font-size: 10px; } Slider { width: 60px; minimum: 0; maximum: 100; value: root.volume; changed(val) => { root.set-volume(val); } } } }
                    Text { text: ""; horizontal-stretch: 1; }
                }
            }
            Rectangle { background: root.surface-color; border-color: root.border-color; border-width: 1px; border-radius: 12px; vertical-stretch: 1;
                VerticalBox { padding: 18px; spacing: 10px; HorizontalBox { height: 28px; Text { text: "COLLECTION"; color: root.text-color; font-size: 16px; font-weight: 700; } Text { text: ""; horizontal-stretch: 1; } Text { text: root.track-items.length + " tracks"; color: #718085; font-size: 12px; vertical-alignment: center; } } Rectangle { height: 28px; background: #eef3f3; border-radius: 5px; HorizontalBox { padding: 10px; Text { text: "#"; color: #718085; width: 36px; } Text { text: "TITLE"; color: #718085; font-size: 10px; font-weight: 700; } } } ListView { for track[index] in root.track-items: Rectangle { height: 38px; background: ta.has-hover ? #eef3f3 : #00000000; border-radius: 6px; ta := TouchArea { HorizontalBox { padding: 10px; Text { text: track; color: root.text-color; vertical-alignment: center; } } clicked => { root.select-track(index); } } } } if root.track-items.length == 0: VerticalBox { alignment: center; Text { text: "Your library is waiting."; color: root.text-color; font-size: 17px; horizontal-alignment: center; } Text { text: "Click 'Scan for MP3s' to begin your local collection."; color: #718085; horizontal-alignment: center; } } }
            }
            HorizontalBox { spacing: 8px; height: 34px; CheckBox { text: "Library"; checked: root.show-library; toggled => { root.toggle-library(); } } CheckBox { text: "Queue"; checked: root.show-queue; toggled => { root.toggle-queue(); } } Text { text: "Theme  ·  " + root.theme-name; color: #718085; vertical-alignment: center; } Text { text: ""; horizontal-stretch: 1; } Button { text: "Next theme"; clicked => { root.next-theme(); } } Button { text: "Save"; clicked => { root.save-theme(); } } Button { text: "Import JSON"; clicked => { root.import-theme(); } } Button { text: "Export JSON"; clicked => { root.export-theme(); } } }
        }

        // Column 3: Dedicated Queue Column (Showing First!)
        Rectangle {
            visible: root.show-queue;
            width: 260px; background: #172326;
            border-width: 1px; border-color: #273739;
            VerticalBox {
                padding: 18px; spacing: 14px;
                HorizontalBox {
                    Text { text: "PLAY QUEUE"; color: root.accent-color; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                    Text { text: ""; horizontal-stretch: 1; }
                    Text { text: root.track-items.length + " queued"; color: #9aabad; font-size: 10px; vertical-alignment: center; }
                }
                Rectangle { height: 1px; background: #385052; }
                ListView {
                    for track[index] in root.track-items: Rectangle {
                        height: 36px; background: ta-queue.has-hover ? #3c5152 : #233538; border-radius: 6px;
                        ta-queue := TouchArea {
                            HorizontalBox {
                                padding: 8px;
                                Text { text: track; color: #ffffff; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            }
                            clicked => { root.select-track(index); }
                        }
                    }
                }
                if root.track-items.length == 0: VerticalBox {
                        alignment: center;
                        Text { text: "Queue is empty."; color: #789092; font-size: 13px; horizontal-alignment: center; }
                        Text { text: "Scan for MP3s to populate queue."; color: #586a6d; font-size: 10px; horizontal-alignment: center; }
                    }
                }
                Rectangle { height: 1px; background: #385052; }
                HorizontalBox {
                    Text { text: "QUEUE (NATIVE RUST)"; color: #8ed0b0; font-size: 9px; font-weight: 700; }
                }
            }
        }
        if root.show-welcome-modal: Rectangle {
            background: #000000a0;
            width: 100%; height: 100%;
            TouchArea { }
            Rectangle {
                width: 400px; height: 280px;
                background: root.surface-color;
                border-radius: 12px;
                border-color: root.border-color;
                border-width: 1px;
                VerticalBox {
                    padding: 32px; spacing: 16px; alignment: center;
                    Text { text: "Welcome to Ahoy"; color: root.accent-color; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Connect your Ahoy ID to unlock your sovereign library and cloud entitlements, or continue with local files only."; color: root.text-color; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                    Text { text: ""; vertical-stretch: 1; }
                    Rectangle {
                        height: 40px; background: ta-login.has-hover ? #197b78 : #1f9591; border-radius: 8px;
                        ta-login := TouchArea {
                            clicked => { root.login-ahoy(); root.dismiss-welcome(); }
                            Text { text: "Sign in with Ahoy ID"; color: #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                    }
                    Rectangle {
                        height: 40px; background: ta-skip.has-hover ? #e0e5e6 : #eef3f3; border-radius: 8px;
                        ta-skip := TouchArea {
                            clicked => { root.dismiss-welcome(); }
                            Text { text: "Continue without signing in"; color: #718085; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                    }
                }
            }
        }

    }
}
}
